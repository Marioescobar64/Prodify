{
  "openapi": "3.0.0",
  "info": {
    "title": "Prodify Auth API",
    "version": "1.0.0",
    "description": "API de Autenticación de Prodify"
  },
  "servers": [
    {
      "url": "http://localhost:5277/api/v1/auth"
    }
  ],
  "paths": {
    "/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Iniciar Sesión",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "correo": { "type": "string" },
                  "contraseña": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Éxito" } }
      }
    },
    "/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Registrar Usuario",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": { "type": "string" },
                  "correo": { "type": "string" },
                  "contraseña": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Registrado" } }
      }
    }
  }
}
